# Supabase project — public, client-safe keys (Project Settings → API in the
# Supabase Dashboard). Used for product-photo storage, the products table,
# and brand_settings (Instagram/Facebook IDs, set via Profile → Connected
# Accounts instead of an env var — see supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
